{
  "name": "cipherboard",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:web": "pnpm --filter @cipherboard/web dev",
    "build:wasm": "pnpm --filter @cipherboard/web build:wasm",
    "build:web": "pnpm --filter @cipherboard/web build",
    "test:web": "pnpm --filter @cipherboard/web test",
    "test:e2e": "pnpm --filter @cipherboard/web test:e2e",
    "typecheck": "pnpm --filter @cipherboard/web typecheck",
    "lint": "pnpm --filter @cipherboard/web lint"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
